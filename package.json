    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
