{
  "name": "sesc-web-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "supabase:verify": "node scripts/verify-supabase-schema.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:seed:local": "node scripts/seed-local-supabase.mjs",
    "test:rls": "node scripts/test-supabase-rls.mjs",
    "check:bundle": "node scripts/check-browser-bundle.mjs",
    "verify:release": "npm run supabase:verify && npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@hookform/resolvers": "^5.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.52.0",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
